// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "button": false,
    "terminal_init_command": "",
    "notify_when_agent_waiting": "all_screens",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "openai/gpt-oss-120b",
    },
    "commit_message_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "openai/gpt-oss-120b",
    },
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": false,
    },
  },

  // Appearance
  "ui_font_family": "Dank Mono P",
  "buffer_font_family": "Dank Mono P",
  "ui_font_size": 18,
  "agent_buffer_font_size": 18,
  "git_commit_buffer_font_size": 18,
  "buffer_font_size": 18,
  "buffer_line_height": {
    "custom": 2,
  },
  "markdown_preview": {
    "font_size": 19,
  },
  "icon_theme": "Zed (Default)",
  "theme": "Everforest Void",
  "theme_overrides": {
    "Vesper": {
      "title_bar.inactive_background": "#101010",
      "terminal.foreground": "#ffffff",
      "terminal.ansi.white": "#ffffff",
      "terminal.ansi.green": "#99FFE4",
      "terminal.ansi.yellow": "#FFC799",
    },
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
      "comment.doc": {
        "font_style": "italic",
      },
    },
  },
  "window_decorations": "server",
  "title_bar": {
    "show_branch_status_icon": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_worktree_name": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
    "show_active_file": true,
  },
  "project_panel": {
    "button": false,
    "auto_open": {
      "on_create": false,
      "on_drop": false,
      "on_paste": false,
    },
    "default_width": 300,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "auto_reveal_entries": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "git_panel": {
    "button": false,
    "tree_view": true,
    "commit_title_max_length": 72,
  },
  "diff_view_style": "split",
  "terminal": {
    "button": false,
    "default_height": 500,
    "cursor_shape": "bar",
    "font_family": "Dank Mono P",
    "font_features": {
      "liga": true,
      "calt": true,
    },
    "scrollbar": {
      "show": "never",
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "file_scan_inclusions": [
    ".env*",
    "apps/api/.env*",
    "apps/evaluator/.env*",
    "apps/web/.env*",
    "packages/*/.env*",
    "docs/*",
  ],
  "scrollbar": {
    "show": "never",
  },
  "current_line_highlight": "none",
  "tab_size": 2,
  "hard_tabs": false,
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "inline_code_actions": false,
  "gutter": {
    "bookmarks": false,
    "breakpoints": false,
    "folds": false,
    "runnables": false,
    "min_line_number_digits": 0,
  },
  "cursor_blink": false,
  "cursor_animation": {
    "enabled": true,
  },
  "hide_mouse": "on_typing_and_action",

  // Behaviors
  "auto_update": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "on",
  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "close_on_file_delete": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "restore_on_file_reopen": false,
  "restore_on_startup": "last_workspace",
  "session": {
    "restore_unsaved_buffers": false,
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "none",
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 10,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "relative_line_numbers": "enabled",
  "soft_wrap": "editor_width",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Vim
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "vim": {
    "highlight_on_yank_duration": 200,
    "use_regex_search": false,
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
  },

  // Languages
  "languages": {
    "TSX": {
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "JavaScript": {
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "CSS": {
      "formatter": [{ "code_action": "source.fixAll.stylelint" }, "prettier"],
    },
    "HTML": {
      "formatter": "prettier",
    },
    "C++": {
      "tab_size": 4,
    },
    "Rust": {
      "tab_size": 4,
    },
    "Python": {
      "tab_size": 4,
      "language_servers": ["ruff", "!pyright"],
    },
    "Shell Script": {
      "tab_size": 4,
    },
  },
}
