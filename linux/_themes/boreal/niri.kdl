layout {
  gaps 2

  focus-ring {
    off
  }

  border {
    on
    width 3
    active-color "#bfc8ce"
    inactive-color "#293236"
  }
}

window-rule {
  geometry-corner-radius 10
}

window-rule {
  match app-id="kitty"
  match app-id="dev.zed.Zed"

  opacity 0.8

  background-effect {
    blur true
  }
}

recent-windows {
  highlight {
    active-color "#bfc8ce"
    padding 10
    corner-radius 10
  }

  previews {
    max-height 480
    max-scale 0.5
  }
}
