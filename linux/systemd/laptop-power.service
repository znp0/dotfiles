[Unit]
Description=CPU cap and AC/battery GPU and niri settings
After=systemd-udev-trigger.service

[Service]
Type=simple
EnvironmentFile=/etc/laptop-power/config.env
ExecStart=/usr/bin/bash /usr/local/lib/laptop-power/laptop-power.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
